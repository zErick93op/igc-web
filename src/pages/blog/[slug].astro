---
import BlogLayout from "../../layouts/BlogLayout.astro";

export async function getStaticPaths() {
  const posts = import.meta.glob('../../content/blog/*.md', { eager: true });

  return Object.entries(posts).map(([path, post]) => {
    const slug = path.split('/').pop().replace('.md', '');
    return {
      params: { slug },
      props: { post }
    };
  });
}

const { post } = Astro.props;
const Post = post.default;
---

<BlogLayout title={post.frontmatter.title}>
  <div class="container my-5">
    <h1>{post.frontmatter.title}</h1>

    {post.frontmatter.image && (
      <img
        src={post.frontmatter.image}
        alt={post.frontmatter.title}
        class="post-hero"
      />
    )}

    <p class="text-muted">
      {post.frontmatter.pubDate} — {post.frontmatter.author}
    </p>

    <article class="post-article">
      <Post />
    </article>
  </div>
</BlogLayout>