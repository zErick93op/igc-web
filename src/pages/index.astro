              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M16.8 8.3c-.9-.5-1.5-1.3-1.7-2.3h-2.6v8.2a2.2 2.2 0 1 1-2.1-2.2c.2 0 .4 0 .6.1V9.4a5 5 0 1 0 4.9 5V10c.8.6 1.8 1 2.9 1.1V8.4c-.7 0-1.3-.1-2-.5z"/>
