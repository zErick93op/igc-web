                <path d="M21.6 7.2c-.2-1-1-1.8-2-2-1.8-.4-9.1-.4-9.1-.4s-7.3 0-9.1.4c-1 .2-1.8 1-2 2C.9 9 .9 12 .9 12s0 3 .4 4.8c.2 1 1 1.8 2 2 1.8.4 9.1.4 9.1.4s7.3 0 9.1-.4c1-.2 1.8-1 2-2 .4-1.8.4-4.8.4-4.8s0-3-.4-4.8zM9.8 15.3V8.7l5.7 3.3-5.7 3.3z"/>
