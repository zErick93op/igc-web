              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M13.5 8.5V7c0-.6.4-1 1-1h1.5V4H14c-2 0-3.5 1.6-3.5 3.6v.9H9V11h1.5v7h3V11H16l.5-2.5h-3z"/>
              </svg>
              <span>Facebook</span>
            </a>
            <a class="social-link social-linkedin" href="https://www.linkedin.com/company/igcinstituto/?originalSubdomain=pe" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn IGC">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6.5 9H4v11h2.5V9zM5.2 8.1c.8 0 1.4-.6 1.4-1.4 0-.8-.6-1.4-1.4-1.4-.8 0-1.4.6-1.4 1.4 0 .8.6 1.4 1.4 1.4zM20 20h-2.5v-5.7c0-1.4-.5-2.3-1.8-2.3-1 0-1.6.7-1.9 1.4-.1.2-.1.6-.1.9V20h-2.5V9h2.5v1.5c.3-.7 1.2-1.7 2.9-1.7 2.1 0 3.7 1.4 3.7 4.4V20z"/>
              </svg>
