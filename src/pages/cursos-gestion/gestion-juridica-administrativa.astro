---
import BaseLayout from "../../layouts/BaseLayout.astro"
---
<BaseLayout title="Gestión Jurídica y Administrativa - IGC">
<link rel="stylesheet" href="/styles/cursos/cursos-gestion.css">

<main>
  <section class="carrusel">
    <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
      <div class="carousel-indicators">
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0"
          class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1"
          aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2"
          aria-label="Slide 3"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="3"
          aria-label="Slide 4"></button>
      </div>

      <div class="carousel-inner">
        <div class="carousel-item active">
          <img src="/img/IGC 1.webp" class="d-block w-100" alt="Imagen Carrusel 1" />
          <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100"></div>
        </div>

        <div class="carousel-item">
          <img src="/img/IGC-2corregido" class="d-block w-100" alt="Imagen Carrusel 2" />
          <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100"></div>
        </div>

        <div class="carousel-item">
          <img src="/img/IGC 3.webp" class="d-block w-100" alt="Imagen Carrusel 3" />
          <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100"></div>
        </div>

        <div class="carousel-item">
          <img src="/img/IGC 4.webp" class="d-block w-100" alt="Imagen Carrusel 4" />
          <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100"></div>
        </div>
      </div>

      <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>

      <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    </div>
  </section>
    <!-- Contenido general de la sección Cursos Gestión Pública -->
    <section class="course-main py-5">
        <div class="container">
            <h1 class="course-title">GESTIÓN JURÍDICA Y ADMINISTRATIVA</h1>
            <div class="course-intro lead">
                <p class="p-down">La Gestión Jurídica y Administrativa es un área interdisciplinaria que busca optimizar el funcionamiento de organizaciones (públicas o privadas) mediante el cumplimiento de la normativa legal y la eficiencia en los procesos internos.</p>
            </div>
            <div class="course-cards row mt-4">
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <img src="/cards-gestionpublica/Procedimiento Administrativo General – Ley 27444.webp"  alt="Imagen de Procedimiento Administrativo General – Ley 27444">
                        <div class="card-body">
                            <p class="card-label">Curso</p>
                            <h5 class="card-title">Procedimiento Administrativo General – Ley 27444</h5>
                            <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                            <a href="/informacion-cursos/procedimiento-administrativo-general-ley" class="card-more">Más Información</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <img src="/cards-gestionpublica/Defensa Jurídica del Estado (Procuraduría).webp"  alt="Imagen de Defensa Jurídica del Estado (Procuraduría)">
                        <div class="card-body">
                            <p class="card-label">Curso</p>
                            <h5 class="card-title">Defensa Jurídica del Estado (Procuraduría)</h5>
                            <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                            <a href="/informacion-cursos/defensa-juridica-del-estado" class="card-more">Más Información</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <img src="/cards-gestionpublica/Gestión Documentaria y Archivo.webp"  alt="Imagen de Gestión Documentaria y Archivo">
                        <div class="card-body">
                            <p class="card-label">Curso</p>
                            <h5 class="card-title">Gestión Documentaria y Archivo</h5>
                            <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                            <a href="/informacion-cursos/gestion-documentaria-archivo" class="card-more">Más Información</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <img src="/cards-gestionpublica/Gestión de Mesa de Partes.webp"  alt="Imagen de Gestión de Mesa de Partes">
                        <div class="card-body">
                            <p class="card-label">Curso</p>
                            <h5 class="card-title">Gestión de Mesa de Partes</h5>
                            <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                            <a href="/informacion-cursos/gestion-mesa-partes" class="card-more">Más Información</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
</BaseLayout>


