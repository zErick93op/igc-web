---
import BaseLayout from "../../layouts/BaseLayout.astro"
---
<BaseLayout title="IA Y Ciencia De Datos - IGC">
<link rel="stylesheet" href="/styles/cursos/cursos-gestion.css">
<main>
  <section class="carrusel">
    <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
      <div class="carousel-indicators">
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0"
          class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1"
          aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2"
          aria-label="Slide 3"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="3"
          aria-label="Slide 4"></button>
      </div>

      <div class="carousel-inner">
        <div class="carousel-item active">
          <img src="/img/IGC 1.webp" class="d-block w-100" alt="Imagen Carrusel 1" />
          <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100"></div>
        </div>

        <div class="carousel-item">
          <img src="/img/IGC-2corregido" class="d-block w-100" alt="Imagen Carrusel 2" />
          <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100"></div>
        </div>

        <div class="carousel-item">
          <img src="/img/IGC 3.webp" class="d-block w-100" alt="Imagen Carrusel 3" />
          <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100"></div>
        </div>

        <div class="carousel-item">
          <img src="/img/IGC 4.webp" class="d-block w-100" alt="Imagen Carrusel 4" />
          <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100"></div>
        </div>
      </div>

      <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>

      <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    </div>
  </section>
    <!-- Contenido general de la sección Cursos Gestión Pública -->
    <section class="course-main py-5">
        <div class="container">
            <h1 class="course-title">IA Y CIENCIA DE DATOS</h1>
            <div class="course-intro lead">
                <p class="p-down">La Inteligencia Artificial (IA) y la Ciencia de Datos (Data Science) son disciplinas interconectadas que combinan matemáticas, programación y conocimientos de negocio para extraer valor de los datos y crear sistemas capaces de "aprender".</p>
            </div>
            <div class="course-cards row mt-4">
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <img src="/cards-gestionpublica/Ciencia de Datos con Python.webp"  alt="Imagen de Ciencia de Datos con Python">
                        <div class="card-body">
                            <p class="card-label">Curso</p>
                            <h5 class="card-title">Ciencia de Datos con Python</h5>
                            <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                            <a href="/informacion-cursos/ciencia-datos-python" class="card-more">Más Información</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <img src="/cards-gestionpublica/Ciencia de Datos y Machine Learning para la Toma de Decisiones.webp"  alt="Imagen de Ciencia de Datos y Machine Learning para la Toma de Decisiones">
                        <div class="card-body">
                            <p class="card-label">Curso</p>
                            <h5 class="card-title">Ciencia de Datos y Machine Learning para la Toma de Decisiones</h5>
                            <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                            <a href="/informacion-cursos/ciencia-datos-ml" class="card-more">Más Información</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <img src="/cards-gestionpublica/Innovación en Comunicación con IA (Uso de ChatGPT y DALL-E).webp"  alt="Imagen de Innovación en Comunicación con IA (Uso de ChatGPT y DALL-E)">
                        <div class="card-body">
                            <p class="card-label">Curso</p>
                            <h5 class="card-title">Innovación en Comunicación con IA (Uso de ChatGPT y DALL-E)</h5>
                            <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                            <a href="/informacion-cursos/innovacion-comunicacion-ia" class="card-more">Más Información</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <img src="/cards-gestionpublica/Optimización de Procesos Institucionales y Empresariales con IA.webp"  alt="Imagen de Optimización de Procesos Institucionales y Empresariales con IA">
                        <div class="card-body">
                            <p class="card-label">Curso</p>
                            <h5 class="card-title">Optimización de Procesos Institucionales y Empresariales con IA</h5>
                            <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                            <a href="/informacion-cursos/optimizacion-procesos-institucionales" class="card-more">Más Información</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
    
</BaseLayout>


