---
import BaseLayout from "../../layouts/BaseLayout.astro"
---
<BaseLayout title="Gestión Minera - IGC">
<link rel="stylesheet" href="/styles/cursos/cursos-gestion.css">

 <main>
        <!-- Carrusel -->
        <section class="carrusel">
            <div id="carouselExampleIndicators" class="carousel slide">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
                </div>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img src="/img/IGC 1.png" class="d-block w-100" alt="">
                    </div>
                    <div class="carousel-item">
                        <img src="/img/IGC 2.png" class="d-block w-100" alt="">
                    </div>
                    <div class="carousel-item">
                        <img src="/img/IGC 3.png" class="d-block w-100" alt="">
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </section>

        <!-- Contenido general de la sección Cursos Gestión Pública -->
        <section class="course-main py-5">
            <div class="container">
                <h1 class="course-title">Gestión Minera</h1>
                <div class="course-intro lead">
                    <p class="p-down">La Gestión Minera es una disciplina compleja que combina la ingeniería técnica, la administración de operaciones a gran escala y la responsabilidad socioambiental. Su objetivo es maximizar la rentabilidad de la extracción de recursos minerales garantizando la seguridad y el cumplimiento normativo.</p>

                </div>
                <div class="course-cards row mt-4">
                    <div class="col-md-4 mb-3">
                        <div class="card h-100">
                            <img src="/cards-gestionpublica/Legislación y Regulación Minera.webp"  alt="Imagen de Legislación y Regulación Minera">
                            <div class="card-body">
                                <p class="card-label">Curso</p>
                                <h5 class="card-title">Legislación y Regulación Minera</h5>
                                <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                                <a href="/informacion-cursos/legislacion-regulacion-minera" class="card-more">Más Información</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="card h-100">
                            <img src="/cards-gestionpublica/Derecho Minero y Ambiental.webp" alt="Imagen de Derecho Minero y Ambiental">
                            <div class="card-body">
                                <p class="card-label">Curso</p>
                                <h5 class="card-title">Derecho Minero y Ambiental</h5>
                                <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                                <a href="/informacion-cursos/derecho-minero-ambiental" class="card-more">Más Información</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="card h-100">
                            <img src="/cards-gestionpublica/Fiscalización y Control Minero.webp"  alt="Imagen de Fiscalización y Control Minero">
                            <div class="card-body">
                                <p class="card-label">Curso</p>
                                <h5 class="card-title">Fiscalización y Control Minero</h5>
                                <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                                <a href="/informacion-cursos/fiscalizacion-control-minero" class="card-more">Más Información</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

</BaseLayout>


