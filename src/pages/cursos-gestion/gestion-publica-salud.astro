---
import BaseLayout from "../../layouts/BaseLayout.astro"
---
<BaseLayout title="Gestión Pública En Salud - IGC">
<link rel="stylesheet" href="/styles/cursos/cursos-gestion.css">

<main>
  <section class="carrusel">
    <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
      <div class="carousel-indicators">
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0"
          class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1"
          aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2"
          aria-label="Slide 3"></button>
        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="3"
          aria-label="Slide 4"></button>
      </div>

      <div class="carousel-inner">
        <div class="carousel-item active">
          <img src="/img/IGC 1.webp" class="d-block w-100" alt="" />
          <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100"></div>
        </div>

        <div class="carousel-item">
          <img src="/img/IGC 2.webp" class="d-block w-100" alt="" />
          <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100"></div>
        </div>

        <div class="carousel-item">
          <img src="/img/IGC 3.webp" class="d-block w-100" alt="" />
          <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100"></div>
        </div>

        <div class="carousel-item">
          <img src="/img/IGC 4.webp" class="d-block w-100" alt="" />
          <div class="carousel-caption d-flex flex-column justify-content-center align-items-center h-100"></div>
        </div>
      </div>

      <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>

      <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    </div>
  </section>
    <!-- Contenido general de la sección Cursos Gestión Pública -->
    <section class="course-main py-5">
        <div class="container">
            <h1 class="course-title">GESTIÓN PÚBLICA EN SALUD</h1>
            <div class="course-intro lead">
                <p class="p-down">La Gestión Pública en Salud abarca el estudio y aplicación de principios, políticas, normativas y herramientas administrativas para organizar, planificar, dirigir y supervisar los servicios de salud en el ámbito público, garantizando la calidad, eficiencia y acceso oportuno a la atención de la población. Los cursos y temas de esta área se enfocan en el fortalecimiento de competencias de los profesionales para la toma de decisiones estratégicas, la gestión de recursos y la mejora de los procesos en las instituciones del sector salud.</p>
            </div>
            <div class="course-cards row mt-4">
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <img src="/cards-gestionpublica/Gestión Pública en Salud.webp"  alt="Imagen de Gestión Pública en Salud">
                        <div class="card-body">
                            <p class="card-label">Curso</p>
                            <h5 class="card-title">Gestión Pública en Salud</h5>
                            <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                            <a href="/informacion-cursos/gestion-publica-salud" class="card-more">Más Información</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <img src="/cards-gestionpublica/Epidemiología y Salud Pública.webp"  alt="Imagen de Epidemiología y Salud Pública">
                        <div class="card-body">
                            <p class="card-label">Curso</p>
                            <h5 class="card-title">Epidemiología y Salud Pública</h5>
                            <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                            <a href="/informacion-cursos/epidemiologia-salud-publica" class="card-more">Más Información</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <img src="/cards-gestionpublica/Gestión de Calidad y Seguridad del Paciente.webp"  alt="Imagen de Gestión de Calidad y Seguridad del Paciente">
                        <div class="card-body">
                            <p class="card-label">Curso</p>
                            <h5 class="card-title">Gestión de Calidad y Seguridad del Paciente</h5>
                            <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                            <a href="/informacion-cursos/gestion-calidad-seguridad-del-paciente" class="card-more">Más Información</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <img src="/cards-gestionpublica/Auditoria de la Gestión de Salud.webp"  alt="Imagen de Auditoria de la Gestión de Salud">
                        <div class="card-body">
                            <p class="card-label">Curso</p>
                            <h5 class="card-title">Auditoria  de la Gestión de Salud</h5>
                            <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                            <a href="/informacion-cursos/auditoria-gestion-salud" class="card-more">Más Información</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
</BaseLayout>


