---
import BaseLayout from "../../layouts/BaseLayout.astro"
---
<BaseLayout title="Gestión De Recursos Humanos y Servicio Civil - IGC">
<link rel="stylesheet" href="/styles/cursos/cursos-gestion.css">
<main>
    <!-- Carrusel -->
    <section class="carrusel">
        <div id="carouselExampleIndicators" class="carousel slide">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
                <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="/img/IGC 1.png" class="d-block w-100" alt="">
                </div>
                <div class="carousel-item">
                    <img src="/img/IGC 2.png" class="d-block w-100" alt="">
                </div>
                <div class="carousel-item">
                    <img src="/img/IGC 3.png" class="d-block w-100" alt="">
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </section>
    <!-- Contenido general de la sección Cursos Gestión Pública -->
    <section class="course-main py-5">
        <div class="container">
            <h1 class="course-title">GESTIÓN DE RECURSOS HUMANOS Y SERVICIO CIVIL</h1>
            <div class="course-intro lead">
                <p class="p-down">La Gestión de Recursos Humanos y Servicio Civil comprende el estudio, aplicación y fortalecimiento de normas, procedimientos y estrategias orientadas a la administración efectiva del capital humano en el sector público y privado. Esta área se enfoca en la planificación, desarrollo, evaluación y motivación del personal, así como en el cumplimiento de la normativa laboral, la Ley del Servicio Civil y su reglamentación</p>
            </div>
            <div class="course-cards row mt-4">
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <img src="/cards-gestionpublica/Gestión de Recursos Humanos en el Sector Público.webp" alt="Imagen de Gestión de Recursos Humanos en el Sector Público">
                        <div class="card-body">
                            <p class="card-label">Curso</p>
                            <h5 class="card-title">Gestión de Recursos Humanos en el Sector Público</h5>
                            <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                            <a href="/informacion-cursos/gestion-resursos-humanos-sector-publico" class="card-more">Más Información</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <img src="/cards-gestionpublica/Marco Legal del Servicio Civil.webp" alt="Imagen de Marco Legal del Servicio Civil">
                        <div class="card-body">
                            <p class="card-label">Curso</p>
                            <h5 class="card-title">Marco Legal del Servicio Civil</h5>
                            <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                            <a href="/informacion-cursos/marco-legal-servicio-civil" class="card-more">Más Información</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <img src="/cards-gestionpublica/Evaluación del Desempeño en el Sector Público.webp" alt="Imagen de Evaluación del Desempeño en el Sector Público">
                        <div class="card-body">
                            <p class="card-label">Curso</p>
                            <h5 class="card-title">Evaluación del Desempeño en el Sector Público</h5>
                            <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                            <a href="/informacion-cursos/evaluacion-desempeño-sector-publico" class="card-more">Más Información</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <img src="/cards-gestionpublica/Gestión por Competencias.webp" alt="Imagen de Gestión por Competencias">
                        <div class="card-body">
                            <p class="card-label">Curso</p>
                            <h5 class="card-title">Gestión por Competencias</h5>
                            <div class="card-meta"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 3h-1V1.5a.5.5 0 0 0-1 0V3H4V1.5a.5.5 0 0 0-1 0V3H2a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zM1 14V5a1 1 0 0 1 1-1h1v1.5a.5.5 0 0 0 1 0V4h6v1.5a.5.5 0 0 0 1 0V4h1a1 1 0 0 1 1 1v9H1z"/></svg><small>Inicio de clases</small></div>
                            <a href="/informacion-cursos/gestion-competencias" class="card-more">Más Información</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>


</BaseLayout>


