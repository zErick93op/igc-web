---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/CTA.astro";
import WhatsAppFlotante from "../components/WhatsAppFlotante.astro"

import "bootstrap/dist/css/bootstrap.min.css"; // Bootstrap 

const { title = "IGC" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Tu CSS global (está en public/styles/style.css) -->
    <link rel="stylesheet" href="/styles/style.css" />

    <!-- Aqui Inyecte el Css extra -->
    <slot name="head"/>

    <!-- Icono -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>


    <Footer />

    {WhatsAppFlotante && (
      <WhatsAppFlotante
        phone="51945504555" /* Número correcto */
        message="Hola, tengo una consulta" /*Podemos Personalizar el mensaje*/
        position="br"     /* br | bl | tr | tl */
        bottom={20}
        sideOffset={20}
        zIndex={12000}    /* súbelo si algo lo tapa */
        showText={true}
      />
    )}

    <!--JS -->
    <script src="/js/script.js" is:inline></script>

    <!-- Bootstrap JS (bundled) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>